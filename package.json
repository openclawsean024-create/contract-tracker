{
  "name": "contract-tracker",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "合約到期與風險條款提醒 — 本機 MVP（不構成法律意見）",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "lint": "tsc --noEmit && tsc --noEmit -p tsconfig.e2e.json",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.e2e.json",
    "test": "vitest --run",
    "test:watch": "vitest",
    "e2e": "npm run build && playwright test"
  },
  "dependencies": {
    "date-fns": "^4.1.0",
    "dexie": "^4.0.8",
    "flexsearch": "^0.7.43",
    "lucide-react": "^0.453.0",
    "mammoth": "^1.13.0",
    "pdfjs-dist": "^4.7.76",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.27.0",
    "recharts": "^2.13.0",
    "uuid": "^10.0.0",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/flexsearch": "^0.7.6",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "fake-indexeddb": "^6.2.5",
    "jszip": "^3.10.2",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.9"
  }
}
